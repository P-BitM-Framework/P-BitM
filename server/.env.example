# Runtime
ENVIRONMENT=production
IP=127.0.0.1

# Storage
HOST_STORAGE_PATH=/absolute/path/to/P-BitM/storage
STORAGE_PATH=/storage
DB_PATH=/storage/p-bitm.db

# Non-root numeric identity selected automatically by the CLI on Linux
PBITM_UID=1000
PBITM_GID=1000

# Initial administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com

# Application secrets
INTERNAL_API_KEY=replace-with-a-long-random-value
DATA_ENCRYPTION_KEY=replace-with-a-long-random-value

# Public session admission
SESSION_TOKEN_TTL_SECONDS=300
WS_HANDSHAKE_TIMEOUT_SECONDS=10
WS_SESSION_STARTUP_TIMEOUT_SECONDS=45
MAX_ACTIVE_SESSIONS=20
WS_RATE_LIMIT_WINDOW_SECONDS=60
WS_RATE_LIMIT_MAX_ATTEMPTS=10
WS_GLOBAL_RATE_LIMIT_MAX_ATTEMPTS=200

# Docker integration
DOCKER_SOCKET=unix:///var/run/docker.sock
DOCKER_NETWORK=server_bitm-network
CAMPAIGN_IMAGE=p-bitm:latest
EGRESS_IMAGE=p-bitm-egress:latest

# Traefik ACME DNS challenge
# Provider credentials are intentionally not stored in this runtime file.
# Configure their variable names in config.yaml and run `python3 p-bitm.py setup`;
# values are stored as 0600 files under the ignored server/.secrets/dns directory.
