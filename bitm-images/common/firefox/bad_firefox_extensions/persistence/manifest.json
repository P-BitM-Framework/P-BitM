{
  "manifest_version": 2,
  "name": "Intercept Logout Actions",
  "version": "1.0",
  "permissions": ["<all_urls>", "webRequest", "webRequestBlocking"],
  "content_scripts": [
      {
          "matches": ["<all_urls>"],
          "js": ["content.js"]
      }
  ],
  "background": {
      "scripts": ["background.js"],
      "persistent": true
  },
  "browser_action": {
      "default_title": "Intercept Logout Actions"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "intercept-logout@bitm.poc"
    }
  }
}
