{
  "manifest_version": 2,
  "name": "Disable all Shortcuts",
  "version": "1.0",
  "content_scripts": [
      {
          "matches": ["<all_urls>"],
          "js": ["content.js"]
      }
  ],
  "browser_action": {
      "default_title": "Disable all Shortcuts"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "disable-shortcuts@bitm.poc"
    }
  }
}
