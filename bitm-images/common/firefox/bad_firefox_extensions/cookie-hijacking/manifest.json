{
  "manifest_version": 2,
  "name": "Cookie Collector",
  "version": "1.3.0",
  "description": "Cookie API collector with server-side value deduplication",

  "permissions": [
    "tabs",
    "cookies",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-collector@bitm.poc"
    }
  }
}
